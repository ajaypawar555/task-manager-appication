# Supabase project URL and server-only secret key (do not use in browser/frontend code).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-secret-key
# Required bearer token guarding every task endpoint. Generate a long random value locally.
API_ACCESS_TOKEN=replace-with-a-long-random-token

# Keep true for deployments. Set false only for isolated local testing.
API_AUTH_ENABLED=true
