# Supabase project URL and server-only secret key (do not use in browser/frontend code).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-secret-key
# Optional bearer-token protection. This starter app defaults to a public API.
API_AUTH_ENABLED=false
# Set API_AUTH_ENABLED=true and add a long random API_ACCESS_TOKEN to enable it.
# API_ACCESS_TOKEN=replace-with-a-long-random-token
